---
layout: null
---
{
  "site": {{ site.url | append: site.baseurl | append: "/" | jsonify }},
  "title": {{ site.title | jsonify }},
  "description": {{ site.tagline | jsonify }},
  "feeds": [
    {
      "title": {{ site.title | append: " Atom Feed" | jsonify }},
      "type": "atom",
      "url": {{ site.url | append: site.baseurl | append: "/atom.xml" | jsonify }},
      "content": "blog posts",
      "format": "application/atom+xml"
    },
    {
      "title": {{ site.title | append: " JSON Feed" | jsonify }},
      "type": "jsonfeed",
      "url": {{ site.url | append: site.baseurl | append: "/feed.json" | jsonify }},
      "content": "blog posts",
      "format": "application/feed+json"
    }
  ]
}
